# Google Search Console meta verification code (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=paste_code_here

# Contact form email (Resend) — required for /contact to deliver messages
# 1. Create a free account at https://resend.com
# 2. Create an API key and paste it below
# 3. On Vercel: Project → Settings → Environment Variables → add the same keys
RESEND_API_KEY=re_xxxxxxxx

# Where messages are delivered (defaults to muhammadalighias@gmail.com)
# CONTACT_TO_EMAIL=muhammadalighias@gmail.com

# Optional: after you verify your domain in Resend, use your own from address
# CONTACT_FROM_EMAIL="MAG Portfolio <hello@muhammadalighias.me>"
